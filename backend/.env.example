# Copy to .env and provide real values. Never commit .env.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/acadnexus
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SMTP settings for password reset emails (configure with your email provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-app-password
SMTP_FROM=AcadNexus <no-reply@example.com>

# Optional Cloudinary media storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Platform-root bootstrap account (created once if absent; use a strong private password)
PLATFORM_OWNER_NAME=Platform Owner
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
# Local development only: sync the configured password on startup.
PLATFORM_OWNER_SYNC_PASSWORD=true

# Only set true for local development; never enable on staging/production.
ALLOW_DEV_PASSWORD_RESET_LINK=false
